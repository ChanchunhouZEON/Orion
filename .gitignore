target


# Data files are ignored from the repo.
*.hdf5
*.ivecs
*.ibin
*.fvecs
*.fbin
*.u8bin*
*.bvecs
*.gz
/data/**/*.bin
/data/**/*.log
# Exclude the sift and gist manually since they are symbolic linked in
# current project.
/data/sift
/data/gist

/*_graphs/

.idea/

# QEMU TCG core dumps — left behind when a binary SIGILLs under the
# Colima x86_64 / QEMU smoke test (qemu64 CPU model lacks AVX-class
# ops, so any rustc-emitted prelude with AVX2/FMA crashes on first
# run). The core files are 20-30 MB each and offer no debug value
# (the crash is by design — see Dockerfile.ci header).
qemu_*.core
**/qemu_*.core
# Generic `core` files — QEMU's userspace emulator running inside the
# bind-mounted docker container writes a 0-byte `core` to cwd when it
# trips on an unsupported instruction. cwd at crash time = our
# workspace root (bind mount), so the marker file leaks back to the
# host filesystem. Prevented at run-time by `--ulimit core=0` on
# docker run (see Dockerfile.ci usage block), gitignored here as
# belt-and-suspenders.
/core
**/core
core.*

# Host bind-mount target for the Colima x86_64 cargo build. The
# real target dir lives inside the docker volume `orion-cargo-target`;
# the host-side directory is just an empty mount point that docker
# auto-creates and we don't want it committed.
/target-linux/

# Local Python extension/package tests (never dataset or experiment outputs).
/orion-py/**/__pycache__/
/orion-py/python/orion_ann/*.so

# Local release artifacts, never published as source.
/dist/

# Local release evidence and preparation utilities.
/docs/release/
/scripts/

# Generated Python bytecode from local tools and CI checks.
**/__pycache__/
*.py[cod]

# Website source and curated measurements live on the independent pages branch.
/orion-site/

# Rust-analyzer configuration is customized by every fork.
rust-analyzer.toml

# Experiment results are excluded.
/visualizations
!/visualizations/**/*.{pdf,png}


# Caches for graph and sidecar are built by users each time a new target 
# context identified.
cache/

.DS_Store
