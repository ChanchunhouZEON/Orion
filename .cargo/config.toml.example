# Enable AVX-512 codegen for the SIMD distance kernels in vector/ and
# staged_diskann/. Routes every `vector::distance_*` and quantized-
# codec hot-path call to the AVX-512 implementation on x86_64; the
# aarch64 (NEON) path is unaffected.
#
# Usage
# ─────
# Either copy this file to `.cargo/config.toml` (Cargo picks it up
# automatically) or set RUSTFLAGS directly:
#
#   RUSTFLAGS="-C target-feature=+avx512f,+avx512bw,+avx512dq,+avx512vl,+avx512vpopcntdq" \
#     cargo build --release
#
# For native CPU detection (Sapphire Rapids, Genoa, etc.):
#   RUSTFLAGS="-C target-cpu=native" cargo build --release
#
# Required CPU features
# ─────────────────────
#   avx512f          foundation, 16-wide f32 / 8-wide f64
#   avx512bw         byte/word ops — needed for l2_u8, ip_i8, ip_i16
#   avx512dq         doubleword/quadword ops — needed for some int paths
#   avx512vl         128/256-bit ops with AVX-512 encoding (some fallbacks)
#   avx512vpopcntdq  population count — needed for RaBitQ Hamming kernels
#
# Target CPUs supporting all of these
# ───────────────────────────────────
#   Intel: Ice Lake Server (3rd-gen Xeon Scalable, 2021) and later
#          — Sapphire Rapids, Emerald Rapids, Granite Rapids
#   AMD:   Zen 4 (EPYC Genoa, Ryzen 7000) and later
#          — Zen 5 (Ryzen 9000)
#
# Skylake-SP / Cascade Lake DO have AVX-512F + BW + DQ + VL but DO NOT
# have avx512vpopcntdq. On those CPUs the popcount-dependent paths
# (RaBitQ) compile but fall back to a scalar popcount loop.
#
# Cross-compiling for x86_64 Linux from Apple Silicon
# ───────────────────────────────────────────────────
# Add the target + a cross linker:
#   rustup target add x86_64-unknown-linux-gnu
#   brew install llvm                  # ld.lld is in /opt/homebrew/opt/llvm/bin
#   # Then in the [target.x86_64-unknown-linux-gnu] block below set
#   #   linker = "/opt/homebrew/opt/llvm/bin/ld.lld"
# Build with:
#   cargo build --release --target x86_64-unknown-linux-gnu

[target.x86_64-unknown-linux-gnu]
rustflags = [
  "-C", "target-feature=+avx512f,+avx512bw,+avx512dq,+avx512vl,+avx512vpopcntdq",
]

# Native build on an x86_64 host (Linux or Windows). Picks every
# feature the host CPU advertises — strongest baseline for benchmarks.
[target.x86_64-pc-windows-msvc]
rustflags = ["-C", "target-cpu=native"]

# On macOS x86_64 (Intel Macs), `target-cpu=native` is enough since
# Apple binaries always run on a known CPU.
[target.x86_64-apple-darwin]
rustflags = ["-C", "target-cpu=native"]
